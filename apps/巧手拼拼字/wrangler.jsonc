{
  // 已畢業為獨立 Worker：qingyiu.com/巧手拼拼字/* 由本 worker 接管，不再走 Pages 全量建構。
  // Worker 名必須 ASCII；對外路徑維持中文前綴，與首頁連結、VITE_BASE_PATH 一致。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qy-pinpinzi",
  "compatibility_date": "2026-09-01",
  // 純前端靜態資產 Worker：無 main / _worker.js，僅 Workers Assets。
  // 認證／AI 若日後用到，走同源 /api/* 子請求，落到 Pages 核心。
  "assets": {
    "directory": ".worker-dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "qingyiu.com/巧手拼拼字/*", "zone_name": "qingyiu.com" }]
}
